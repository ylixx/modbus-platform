# ===========================
# Modbus 数据采集平台 · 生产/正式版数据库配置示例
# 复制本文件为 .env 并按需修改。所有项均可选，留空即回退开发期行为。
# ===========================

# ── 主关系库（设备/标签/用户/权限/SCADA 配置等）──
# 留空 → 回退到下方 DB_* 拼出的 MySQL；或显式指定完整 URL（如 SQLite 开发库）
# DATABASE_URL=sqlite:///./modbus_platform.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=modbus
DB_PASSWORD=change_me
DB_NAME=modbus_platform

# ── 历史库（聚合/长期历史，正式版用独立 MySQL 实例，与主库隔离）──
# 留空 → 复用主库 engine（开发期单库行为不变）
# HISTORY_DATABASE_URL=mysql+pymysql://modbus:change_me@127.0.0.1:3306/modbus_history?charset=utf8mb4

# ── 时序库（原始高频测点）──
# TIMESERIES_TYPE 留空 → 原始点仍写关系库 tag_history（开发期行为）
# 选型（用户决策：Windows 环境）：
#   tdengine  【主用】TDengine 开源版（AGPLv3，Windows 友好，国产工业时序库，高频测点首选）
#   iotdb     【备选·无上限】Apache IoTDB，Apache-2.0 完全免费、无任何测点上限；若 TDengine 开源版
#             仍遇 5k 测点墙，改 TIMESERIES_TYPE=iotdb 即可无上限（代码已就绪，无需改业务）
#   timescaledb | influxdb | clickhouse ：亦可，适配器可后续补
# TIMESERIES_TYPE=tdengine
# TIMESERIES_HOST=127.0.0.1
# TIMESERIES_PORT=6041            # TDengine REST 默认 6041（IoTDB 用 6667）
# TIMESERIES_USER=root
# TIMESERIES_PASSWORD=taosdata
# TIMESERIES_DATABASE=modbus_ts   # TDengine database / IoTDB storage group 名
# TIMESERIES_TOKEN=               # influxdb 等需要 token 时填
# pip install taos-rest           # TDengine REST 客户端（未装仅告警不崩）
# pip install apache-iotdb        # IoTDB 客户端（仅用 iotdb 时需要）
# 仅当 TIMESERIES_TYPE 已配置时生效：
#   false(默认)= 原始点双写（关系库 tag_history 保留，便于历史 API 过渡）
#   true         = 原始点只写时序库，不再写关系库 tag_history
# TIMESERIES_RAW_ONLY=false

# ── Redis 缓存库（最新值缓存 / 多 worker WebSocket 广播 / 会话）──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── 安全 ──
SECRET_KEY=please-set-a-strong-random-key-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Modbus ──
MODBUS_POLL_INTERVAL=5.0
MODBUS_TIMEOUT=3.0
MODBUS_RETRIES=3

# ── 短信提供商 (演示无需配置) ──
SMS_PROVIDER=aliyun

# ── 报警 ──
ALARM_CHECK_INTERVAL=2.0
MAX_SMS_PER_HOUR=50

# ── CORS ──
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
